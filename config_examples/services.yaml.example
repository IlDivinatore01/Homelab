# ===========================================
# Homepage Services Configuration Example
# ===========================================
# Copy to data/homepage/config/services.yaml
# 
# NOTE: For widgets with API keys, use environment variables:
#   key: {{HOMEPAGE_VAR_IMMICH_API_KEY}}
# 
# Add the env var to homepage.pod.yaml:
#   - name: HOMEPAGE_VAR_IMMICH_API_KEY
#     valueFrom:
#       secretKeyRef:
#         name: homepage-immich-key-k8s
#         key: apikey

# ============================================
# 📸 Media & Storage
# ============================================
- Media:
    - Immich:
        icon: immich
        href: https://gallery.yourdomain.com
        description: Photo Management & AI
        widget:
          type: immich
          url: https://gallery.yourdomain.com
          key: {{HOMEPAGE_VAR_IMMICH_API_KEY}}

    - Garage S3:
        icon: mdi-database
        href: https://garage.yourdomain.com
        description: S3-compatible storage

# ============================================
# 💰 Finance
# ============================================
- Finance:
    - Firefly III:
        icon: firefly-iii
        href: https://finanza.yourdomain.com
        description: Personal Finance Manager

    - Metabase:
        icon: metabase
        href: https://analytics.yourdomain.com
        description: Financial Analytics Dashboard

# ============================================
# 🛠️ Admin & Monitoring
# ============================================
- Admin & Monitoring:
    - Portainer:
        icon: portainer
        href: https://portainer.yourdomain.com
        description: Container Management

    - Uptime Kuma:
        icon: uptime-kuma
        href: https://status.yourdomain.com
        description: Uptime Monitoring

    - IT-Tools:
        icon: it-tools
        href: https://tools.yourdomain.com
        description: Developer Utilities

    - Cockpit:
        icon: si-cockpit
        href: https://panel.yourdomain.com
        description: System & Podman UI

    - ntfy:
        icon: ntfy
        href: https://notify.yourdomain.com
        description: Push Notifications

# ============================================
# 🍔 Projects
# ============================================
- Projects:
    - Portfolio:
        icon: mdi-web
        href: https://yourdomain.com
        description: Personal Website

    - FastFood App:
        icon: mdi-food
        href: https://fastfood.yourdomain.com
        description: Demo Food Delivery App
