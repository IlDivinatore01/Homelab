# ===========================================
# Homelab Environment Variables - TEMPLATE
# ===========================================
# Copy this file to .env and fill in real values.
# DO NOT commit the .env file (it's in .gitignore).
#
# Required permissions: chmod 600 .env

# --- Garage S3 (local backup storage) ---
GARAGE_S3_ENDPOINT="http://localhost:3900"
GARAGE_S3_BUCKET="backups"
GARAGE_S3_REGION="garage"
GARAGE_S3_ACCESS_KEY="REPLACE_WITH_GARAGE_ACCESS_KEY"
GARAGE_S3_SECRET_KEY="REPLACE_WITH_GARAGE_SECRET_KEY"
